{
  "name": "dsh-growth",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools for evidence-backed user growth, customer acquisition, AARRR funnels, retention, unit economics and MRR.",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    }
  },
  "files": [
    "lib",
    ".codex-plugin",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md",
    "PLAN.md",
    "assets",
    "references",
    "skills/growth-acquisition-execution/SKILL.md",
    "skills/growth-acquisition-execution/scripts/audit_submission_record.py",
    "skills/growth-acquisition-execution/tests/test_audit_submission_record.py",
    "skills/growth-ai-discoverability/SKILL.md",
    "skills/growth-operator/SKILL.md",
    "skills/growth-strategy-planning/SKILL.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "plugin:pack:validate": "node scripts/validate-package.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run plugin:validate && pnpm run plugin:pack:validate"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/winyh/dsh-growth"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "growth-hacking",
    "aarrr",
    "retention",
    "mrr",
    "obsidian"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsdown": "^0.16.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
